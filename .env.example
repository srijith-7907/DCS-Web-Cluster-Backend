# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/event_ticketing
# JWT
JWT_SECRET_KEY=change-me-super-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@events.local
SMTP_USE_TLS=false
# App
APP_NAME=Event Ticketing API
APP_ENV=development
